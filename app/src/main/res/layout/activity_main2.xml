<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <ImageView
        android:id="@+id/nightSkyImg2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/nigth_sky_background"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/nighth_sky" />

    <TextView
        android:id="@+id/lblMainMenu2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:text="@string/what_kind_of_dreamer_are_you"
        android:textColor="#CAC3C3"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/nextBttn2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblMainMenu2"
        app:layout_constraintVertical_bias="0.49">

        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/container_section2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/header_section2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#152533"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblMemoryDream"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="8"
                        android:text="@string/ii_memories_of_dreams"
                        android:textColor="#E0E0E0" />

                    <ImageView
                        android:id="@+id/ImgArrowSectionUp2"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@string/arrow_that_show_the_content_of_this_section"
                        android:rotation="180"
                        app:srcCompat="@android:drawable/arrow_up_float" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body_section2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/lblQuestion4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/how_often_do_you_have_dreams"
                        android:textColor="#F5F5F5" />

                    <TextView
                        android:id="@+id/lblSeekbarTracker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#F5F5F5"
                        android:translationX="10dp" />

                    <SeekBar
                        android:id="@+id/lblSeekBar"
                        style="@android:style/Widget.Material.Light.SeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="10"
                        android:maxWidth="5dp"
                        android:progressTint="#F5F5F5" />

                    <TextView
                        android:id="@+id/lblQuestion5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/how_detailed_are_your_dreams"
                        android:textColor="#F5F5F5" />

                    <RatingBar
                        android:id="@+id/ratingBar3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:outlineAmbientShadowColor="#F5F5F5"
                        android:outlineSpotShadowColor="#F5F5F5" />

                    <TextView
                        android:id="@+id/lblQuestion6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/what_emotion_stands_out_most_in_your_dreams"
                        android:textColor="#F5F5F5" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <Switch
                                android:id="@+id/swtAnswerJoy"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/joy"
                                android:textColor="#F5F5F5" />

                            <Switch
                                android:id="@+id/swtAnswerConfusion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/confusion"
                                android:textColor="#F5F5F5" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <Switch
                                android:id="@+id/swtAnswerFear"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/fear"
                                android:textColor="#FFFFFF" />

                            <Switch
                                android:id="@+id/swtAnswerFrustration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/frustration"
                                android:textColor="#F5F5F5" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_section3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/header_section3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#2E5271"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblDreamContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="9"
                        android:text="@string/iii_dream_content"
                        android:textColor="#D7CCC8" />

                    <ImageView
                        android:id="@+id/imgArrowSection3"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@string/arrow_that_show_the_content_of_this_section"
                        app:srcCompat="@android:drawable/arrow_up_float" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body_section3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/lblQuestion7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/which_topics_come_up_most_often"
                        android:textColor="#F5F5F5" />

                    <LinearLayout
                        android:id="@+id/bodyHoriLbl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lblSpace"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/lblOften"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/often"
                            android:textColor="#F5F5F5" />

                        <TextView
                            android:id="@+id/lblSometime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sometimes"
                            android:textColor="#F5F5F5" />

                        <TextView
                            android:id="@+id/lblRarely"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/rarely"
                            android:textColor="#F5F5F5" />

                        <TextView
                            android:id="@+id/lblNever"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/never"
                            android:textColor="#F5F5F5" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bodyHoriFamily"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lblFamily"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:paddingTop="12dp"
                            android:text="@string/family"
                            android:textAlignment="center"
                            android:textColor="#F5F5F5" />

                        <RadioGroup
                            android:id="@+id/RGFamily"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="4"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbFamilyOften"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="#F5F5F5"
                                android:textColorHighlight="#F5F5F5"
                                android:textColorHint="#F5F5F5"
                                android:textColorLink="#F5F5F5" />

                            <RadioButton
                                android:id="@+id/rbFamilySometime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <RadioButton
                                android:id="@+id/rbFamilyRarely"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <RadioButton
                                android:id="@+id/rbFamilyNever"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />
                        </RadioGroup>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bodyHoriLove"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lblLove"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:paddingTop="12dp"
                            android:text="@string/love"
                            android:textAlignment="center"
                            android:textColor="#F5F5F5" />

                        <RadioGroup
                            android:id="@+id/RGLove"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="4"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbLoveOften"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <RadioButton
                                android:id="@+id/rbLoveSometime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <RadioButton
                                android:id="@+id/rbLoveRarely"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <RadioButton
                                android:id="@+id/rbLoveNever"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />
                        </RadioGroup>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bodyHoriWork"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lblWork"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:paddingTop="12dp"
                            android:text="@string/work"
                            android:textAlignment="center"
                            android:textColor="#F5F5F5" />

                        <RadioGroup
                            android:id="@+id/RGWork"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="4"
                            android:minWidth="48dp"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbWorkOften"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:maxWidth="48dp"
                                android:minHeight="48dp" />

                            <RadioButton
                                android:id="@+id/rbWorkSometime"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:maxWidth="48dp"
                                android:minHeight="48dp" />

                            <RadioButton
                                android:id="@+id/rbWorkRarely"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:maxWidth="48dp"
                                android:minHeight="48dp" />

                            <RadioButton
                                android:id="@+id/rbWorkNever"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:maxWidth="48dp"
                                android:minHeight="48dp" />
                        </RadioGroup>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bodyHoriFall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lblFall"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:paddingTop="12dp"
                            android:text="@string/fall"
                            android:textAlignment="center"
                            android:textColor="#F5F5F5" />

                        <RadioGroup
                            android:id="@+id/RGFall"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="4"
                            android:minWidth="48dp"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbFallOften"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:width="48dp"
                                android:maxWidth="48dp"
                                android:minWidth="48dp"
                                android:minHeight="48dp" />

                            <RadioButton
                                android:id="@+id/rbFallSometime"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:width="48dp"
                                android:maxWidth="48dp"
                                android:minWidth="48dp"
                                android:minHeight="48dp" />

                            <RadioButton
                                android:id="@+id/rbFallRarely"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:width="48dp"
                                android:maxWidth="48dp"
                                android:minWidth="48dp"
                                android:minHeight="48dp" />

                            <RadioButton
                                android:id="@+id/rbFallNever"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:width="48dp"
                                android:maxWidth="48dp"
                                android:minWidth="48dp"
                                android:minHeight="48dp" />
                        </RadioGroup>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/nextBttn2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/next"
        app:layout_constraintBottom_toBottomOf="@+id/nightSkyImg2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>